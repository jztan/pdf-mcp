# Copy to .env (gitignored) or run deploy/bootstrap.sh to generate it.
# Compose auto-loads .env for both variable interpolation (${VAR} in
# docker-compose.yml) and the container's env_file - one file, both jobs.

# REQUIRED. The HTTP transport refuses to start without it. Clients send it
# as "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
PDF_MCP_AUTH_TOKEN=

# Host port this container publishes on, bound to loopback only.
# Per-server so several MCP containers can run at once; the container port
# stays 8000. Suggested block: redmine-mcp 8801, pdf-mcp 8802.
PDF_MCP_HOST_PORT=8802

# Cache time-to-live in hours (default 24).
# PDF_MCP_CACHE_TTL=24

# Parallel OCR/render workers. 0 or 1 forces sequential.
# PDF_MCP_MAX_WORKERS=8

# Escape hatch: start without a [paths] allow list. Only set this if you
# constrain the filesystem another way (read-only rootfs, empty container).
# PDF_MCP_ALLOW_ANY_PATH=1

# Image tag to run. Default: latest. Pin an exact version (e.g. 2.0.0) if
# you want your stack to stay put across releases. Only used by
# docker-compose.yml interpolation; the server itself ignores it.
# PDF_MCP_IMAGE_TAG=latest
