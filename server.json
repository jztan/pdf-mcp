{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jztan/pdf-mcp",
  "description": "Agentic RAG over one PDF or a whole folder: hybrid search, selective page reads, tables, OCR.",
  "repository": {
    "url": "https://github.com/jztan/pdf-mcp",
    "source": "github"
  },
  "version": "3.5.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "pdf-mcp",
      "version": "3.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Directory for storing PDF cache (default: ~/.cache/pdf-mcp)",
          "format": "string",
          "name": "PDF_MCP_CACHE_DIR"
        },
        {
          "description": "Cache time-to-live in hours (default: 24)",
          "format": "number",
          "name": "PDF_MCP_CACHE_TTL"
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/jztan/pdf-mcp/releases/download/v3.5.0/pdf-mcp-3.5.0.mcpb",
      "fileSha256": "75cdeacccf0ad5e035041a2dc15306cecad1f5ff79351852df801d4271cbaba1",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
